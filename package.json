{
  "name": "chatgpt-wrapped",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b && tsc -p tsconfig.checks.json",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:compatibility": "vitest run tests/compatibility.test.ts",
    "test:e2e": "playwright test",
    "build:pages": "tsc -b && vite build --base=/ChatGPT-Wrapped/"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.24.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.14.0",
    "jszip": "^3.10.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
